+function eme_stripe_create_session( $payment, $price, $cur, $description, $item_name, $ui_mode = 'hosted' ) {
+    $gateway                = 'stripe';
+    $eme_stripe_private_key = get_option( 'eme_stripe_private_key' );
+    require_once EME_PLUGIN_DIR . 'payment_gateways/stripe/vendor/autoload.php';
+    \Stripe\Stripe::setApiKey( "$eme_stripe_private_key" );
+    \Stripe\Stripe::setAppInfo( 'WordPress Events Made Easy Stripe plugin' );
+
+    $payment_methods = get_option( 'eme_stripe_payment_methods' );
+    if ( empty( $payment_methods ) ) {
+        $payment_methods = 'card';
+    }
+    // make sure it is an array with numeric keys
+    if ( ! is_array( $payment_methods ) ) {
+        $payment_methods_arr = explode( ',', $payment_methods );
+    } else {
+        $payment_methods_arr = $payment_methods;
+    }
+
+    $stripe_session_params = [
+        'payment_method_types' => $payment_methods_arr,
+        'payment_intent_data'  => [ 'description' => $description ],
+        'line_items'           => [
+            [
+                'price_data' => [
+                    'currency'     => strtolower( $cur ),
+                    'unit_amount'  => $price,
+                    'product_data' => [
+                        'name'        => $item_name,
+                        'description' => $description,
+                    ],
+                ],
+                'quantity'   => 1,
+            ],
+        ],
+        'mode'                 => 'payment',
+        'client_reference_id'  => $payment['id'],
+    ];
+
+    if ( $ui_mode === 'embedded' ) {
+        $stripe_session_params['ui_mode']    = 'embedded_page';
+        $stripe_session_params['return_url'] = eme_payment_return_url( $payment, $gateway );
+    } else {
+        $stripe_session_params['success_url'] = eme_payment_return_url( $payment, $gateway );
+        $stripe_session_params['cancel_url']  = eme_payment_url( $payment );
+    }
+
+    // prefill e-mail in Stripe form if possible
+    $customer_email = '';
+    if ( $payment['target'] === 'member' ) {
+        $member_ids = eme_get_payment_member_ids( $payment['id'] );
+        if ( $member_ids ) {
+            $member = eme_get_member( $member_ids[0] );
+            if ( ! empty( $member ) ) {
+                $person = eme_get_person( $member['person_id'] );
+                if ( ! empty( $person ) ) {
+                    $customer_email = $person['email'];
+                }
+            }
+        }
+    } else {
+        $booking_ids = eme_get_payment_booking_ids( $payment['id'] );
+        if ( $booking_ids ) {
+            $booking = eme_get_booking( $booking_ids[0] );
+            if ( ! empty( $booking ) ) {
+                $person = eme_get_person( $booking['person_id'] );
+                if ( ! empty( $person ) ) {
+                    $customer_email = $person['email'];
+                }
+            }
+        }
+    }
+    if ( ! empty( $customer_email ) ) {
+        $stripe_session_params['customer_email'] = $customer_email;
+    }
+
+    $stripe_session = \Stripe\Checkout\Session::create( $stripe_session_params );
+    eme_update_payment_pg_pid( $payment['id'], $stripe_session->id );
+
+    return $stripe_session;
+}
